# Claude Agent SDK
ANTHROPIC_API_KEY=

# Apify — use the TEAM account token, not your personal one.
# Switch to the team account in the Apify Console before generating this.
APIFY_API_TOKEN=
# Actor used by the discover_companies tool. Confirmed working via a live test
# run (pay-per-event, ~$0.05 + ~$0.002/result, 100-result minimum per call).
APIFY_ORGANIZATIONS_ACTOR_ID=braveleads/company-organization-finder-apollo-linkedin

# Firecrawl
FIRECRAWL_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Never expose this to the client / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
